    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno es (?:solo|sólo|solamente|únicamente) [^.!?\\n]{2,60}[,.;] (?:es|sino)\\b",
      "nombre": "«No es solo X, es Y»",
      "arreglo": "Di la única cosa que quieres decir. Borra la mitad que prepara."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
      "nombre": "«No solo X, sino también Y»",
      "arreglo": "Pártelo en dos frases o quita la mitad más floja."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[,.;] se trata de\\b",
      "nombre": "«No se trata de X, se trata de Y»",
      "arreglo": "Empieza por Y. El giro es lo que delata."
    },
    {
      "id": "pregunta-teatral",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|la clave|el truco|la trampa|lo peor|¿y sabes qué)\\?\\s*$",
      "nombre": "Pregunta de una línea para crear intriga",
      "arreglo": "Respóndela en la misma frase en vez de montar la revelación."
    },
    {
      "id": "lo-que-aprendi",
      "regex": "(?i)\\b(?:esto es lo que|lo que) (?:he aprendido|aprendí)\\b",
      "nombre": "«Esto es lo que aprendí»",
      "arreglo": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
      "nombre": "Tríada de tres elementos",
      "arreglo": "Dos o cuatro. Tres es el ritmo por defecto de los modelos."
    },
    {
      "id": "emojis-tipicos",
      "regex": "[🚀🔥💡✨🎯]",
      "nombre": "Emoji de cohete, fuego, bombilla, chispas o diana",
      "arreglo": "Un emoji como mucho, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#[\\wÁÉÍÓÚÜÑáéíóúüñ]+[ \\t]*){6,}",
      "nombre": "Muro de hashtags (6 o más)",
      "arreglo": "Tres o cuatro del tema. En Instagram, cinco es el tope."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
      "nombre": "El modelo hablando de sí mismo",
      "arreglo": "Borra la frase."
    },
    {
      "id": "cierre-redaccion",
      "regex": "(?im)^\\s*(?:en conclusión|en resumen|para concluir|en definitiva)\\b",
      "nombre": "Cierre de redacción escolar",
      "arreglo": "Un post no necesita párrafo de conclusión."
    },
    {
      "id": "cebo-reflejo",
      "regex": "(?i)(?:¿(?:estás de acuerdo|qué opinas|tú qué opinas|y tú)\\?|¿quién más\\b[^?]*\\?)\\s*$",
      "nombre": "Pregunta de cebo automática",
      "arreglo": "Haz una pregunta que solo podrías hacer tú, sobre lo que acabas de contar."
    },
    {
      "id": "para-scroll",
      "regex": "(?im)^\\s*¡?\\s*(?:deja de hacer scroll|no hagas scroll|para de deslizar|espera,? no (?:pases|deslices))\\b",
      "nombre": "Arranque «deja de hacer scroll»",
      "arreglo": "Lo que para el scroll tiene que ser la propia idea. Pedir atención delata que no te la has ganado."
    },
    {
      "id": "preambulo-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:vídeo|video|reel)(?: de hoy)?|hoy (?:os|te) voy a (?:enseñar|contar|explicar|mostrar)|te voy a (?:enseñar|mostrar) cómo)\\b",
      "nombre": "Preámbulo de vídeo («en el vídeo de hoy os voy a enseñar»)",
      "arreglo": "Bórralo y empieza por el resultado. Los dos primeros segundos deciden todo."
    },
    {
      "id": "lista-emojis",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨]\\s*\\S",
      "nombre": "Lista con emojis como viñetas",
      "arreglo": "Usa un guion o un salto de línea. Es lo que más huele a plantilla."
    },
    {
      "id": "mayusculas",
      "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
